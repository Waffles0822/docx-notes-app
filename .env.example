# Copy this file to .env.local and fill in your own values.
# Never commit real credentials to this template.
OPENAI_API_KEY=your_openai_api_key_here

# Optional. Defaults to the model configured in src/lib/ai-service.ts when unset.
OPENAI_MODEL=
OPENAI_PROMPT_CACHE_KEY=docunotes-notes-v1

# Optional server-only organization admin key for the dashboard credit balance.
OPENAI_ADMIN_KEY=
OPENAI_INITIAL_CREDITS=4.96

# Optional offline preview. A configured OpenAI key always takes precedence.
USE_MOCK_AI=false

# Google Docs Import (OAuth 2.0)
# Get these from https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback (dev)
# Authorized redirect URI: https://your-vercel-domain.vercel.app/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
